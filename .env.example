DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/urundedektifi
PAYLOAD_SECRET=YOUR_SECRET_HERE

# S3 / object storage (media dosyaları için)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_ENDPOINT=

# E-posta / SMTP (itiraz bildirimleri). Boşsa adaptör kurulmaz; kayıt yine yazılır.
# OBJECTION_EMAIL: itiraz bildirimi alacak adres (boşsa rustemaydinnn@gmail.com).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OBJECTION_EMAIL=

# Google ile giriş (Google Cloud Console → APIs & Services → Credentials)
# Sunucu, ID token'ın seyircisini (aud) bu listeye göre doğrular. Web + Android + iOS
# istemcileri ayrı client ID taşır; kullanılanların hepsi burada olmalı.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Tarayıcıdaki Google düğmesi (GIS) bu istemci ID'sini kullanır; genelde GOOGLE_CLIENT_ID ile aynı.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
